# Copia este archivo a .env para desarrollo local (nunca subas .env real a git).

# Integración interna de Notion (notion.so/my-integrations) — debe tener
# acceso concedido a la base "Marketing Aplatanao — Asistentes"
# (desde Notion: "..." en la base -> Add connections -> tu integración).
NOTION_API_KEY=

# ID de la base de datos (la URL de tu base:
# https://app.notion.com/p/<ESTE_ID>)
NOTION_DATABASE_ID=e41de6d05f0746e1a828b07423750cb4

# API key de OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Contraseña compartida del panel admin
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del admin (cualquier cadena larga y aleatoria)
ADMIN_SESSION_SECRET=

PORT=3000
